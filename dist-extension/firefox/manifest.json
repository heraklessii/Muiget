{
  "manifest_version": 3,
  "name": "Muiget",
  "version": "0.1.5",
  "description": "Bağlantıları Muiget indirme yöneticisine gönderir. Çoklu bağlantı, kaldığı yerden devam.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "downloads",
    "cookies",
    "webRequest"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Muiget",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "muiget@muiget.app",
      "strict_min_version": "128.0"
    }
  }
}
